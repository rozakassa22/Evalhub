# Copy to `.env` and adjust. All variables are prefixed with EVALHUB_.

# Service
EVALHUB_ENVIRONMENT=development
EVALHUB_LOG_LEVEL=info
EVALHUB_LOG_JSON=false

# Evaluation engine
EVALHUB_MAX_CONCURRENCY=16

# LLM-as-judge (optional). Leave the key unset to use the offline heuristic judge.
EVALHUB_JUDGE_BACKEND=heuristic
EVALHUB_ANTHROPIC_MODEL=claude-opus-4-8
# EVALHUB_ANTHROPIC_API_KEY=sk-ant-...
EVALHUB_JUDGE_TIMEOUT_SECONDS=30
